# ===== Claude auth =====
# Two ways to authenticate — pick one.
#
# (1) Claude Code OAuth (default — uses your Claude Pro/Max subscription):
#     Just leave ANTHROPIC_API_KEY commented out. The SDK spawns the `claude`
#     CLI which is already logged in on your machine. Zero extra cost.
#
# (2) Anthropic API key (per-token billing via console.anthropic.com):
#     Uncomment the line below and paste your key.
#
# ANTHROPIC_API_KEY=sk-ant-...

# ===== Database =====
DATABASE_URL=postgresql://agentboard:agentboard@localhost:55432/agentboard

# ===== Redis =====
REDIS_URL=redis://localhost:56379

# ===== Orchestrator =====
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_HOST=0.0.0.0
LOG_LEVEL=info

# Max turns per agent invocation (guard against runaway loops)
AGENT_MAX_TURNS=25

# Default working directory where git worktrees are created
WORKSPACE_ROOT=./workspace

# Per-agent turn timeout in ms
AGENT_TURN_TIMEOUT_MS=300000

# ===== Web =====
WEB_PORT=5173
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# ===== GitHub OAuth (optional but recommended) =====
# Register an OAuth App at https://github.com/settings/applications/new
# Set its Authorization callback URL to GITHUB_OAUTH_REDIRECT_URL.
# Without these, AgentBoard still works via the `gh` CLI or a PAT.
# GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3001/api/github/oauth/callback

# ===== GitHub App (optional, for fine-grained per-repo install) =====
# Register an App at https://github.com/settings/apps/new
# Webhook URL → http://YOUR_PUBLIC_HOST/api/github/webhook
# GITHUB_APP_ID=000000
# GITHUB_APP_CLIENT_ID=Iv23xxxxxxxx
# GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxx
# GITHUB_APP_NAME=agentboard-yourorg
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=replace-me-with-a-random-string
