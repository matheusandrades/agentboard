{
  "name": "agentboard",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent engineering team visualized as a Scrum/Kanban board. Each team member is a long-lived Claude Agent SDK session.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:prod": "docker compose --profile prod up -d --build",
    "infra:prod:down": "docker compose --profile prod down",
    "db:migrate": "corepack pnpm --filter @agentboard/orchestrator db:migrate",
    "db:seed": "corepack pnpm --filter @agentboard/orchestrator db:seed",
    "redis:reset": "corepack pnpm --filter @agentboard/orchestrator exec tsx ../../scripts/redis_reset.ts",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres && sleep 3 && pnpm db:migrate && pnpm db:seed && pnpm redis:reset",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "delete": "pm2 delete ecosystem.config.cjs",
    "logs": "pm2 logs",
    "monit": "pm2 monit",
    "dev": "pnpm infra:up && pnpm db:migrate && pnpm start && pnpm logs",
    "build": "corepack pnpm -r --filter './apps/*' --filter './packages/*' build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint"
  },
  "devDependencies": {
    "pm2": "^5.4.2",
    "typescript": "^5.6.2"
  }
}
